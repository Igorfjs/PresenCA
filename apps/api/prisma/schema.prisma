generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorkspaceRole {
  ADMIN
  ORGANIZER
}

enum PersonType {
  MEMBER
  VISITOR
}

enum RecordStatus {
  ACTIVE
  INACTIVE
}

enum EventStatus {
  CONFIRMED
  SCHEDULED
  IN_PROGRESS
  ENDED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  JUSTIFIED
}

model Workspace {
  id          String                @id @default(cuid())
  name        String
  description String?
  slug        String                @unique
  createdAt   DateTime              @default(now()) @db.Timestamptz(3)
  memberships WorkspaceMembership[]
  missionMembers Person[]           @relation("PersonMission")
  events      Event[]
  series      RecurringSeries[]
  auditLogs   AuditLog[]
}

model User {
  id              String                @id @default(cuid())
  /// Must reference a Person with type MEMBER; enforce this in the API/domain service.
  personId        String                @unique
  email           String                @unique
  passwordHash    String
  active          Boolean               @default(true)
  deletedAt       DateTime?             @db.Timestamptz(3)
  createdAt       DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime              @updatedAt @db.Timestamptz(3)
  person          Person                @relation(fields: [personId], references: [id])
  memberships     WorkspaceMembership[]
  responsibleFor  Event[]               @relation("EventResponsible")
  responsibleForSeries RecurringSeries[] @relation("SeriesResponsible")
  recordedEntries Attendance[]          @relation("AttendanceRecorder")
  auditLogs       AuditLog[]

  @@index([active, deletedAt])
}

model WorkspaceMembership {
  id          String       @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole
  deletedAt   DateTime?   @db.Timestamptz(3)
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(3)
  workspace   Workspace   @relation(fields: [workspaceId], references: [id])
  user        User        @relation(fields: [userId], references: [id])

  @@unique([workspaceId, userId])
  @@index([userId, role, deletedAt])
}

model Person {
  /// Stable global identity shared across missions. Never assign a different ID when the person changes mission.
  id          String       @id @default(cuid())
  /// Store the normalized display name: lowercase, with the first letter of each word uppercase.
  name        String
  type        PersonType
  /// Required for members and optional for visitors; validate according to `type` in the API.
  birthDate   DateTime?    @db.Date
  /// Current mission. Required for members and null for visitors unless product rules change.
  missionId   String?
  email       String?
  phone       String?
  city        String?
  groupName   String?
  position    String?
  status      RecordStatus @default(ACTIVE)
  joinedAt    DateTime?    @db.Date
  notes       String?
  deletedAt   DateTime?   @db.Timestamptz(3)
  anonymizedAt DateTime?  @db.Timestamptz(3)
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(3)
  mission     Workspace?  @relation("PersonMission", fields: [missionId], references: [id])
  user        User?
  attendance  Attendance[]

  /// Deliberately no unique constraint on name: homonyms are allowed after administrative confirmation.
  @@index([missionId, type, status, deletedAt])
  @@index([name])
  @@index([email])
}

model RecurringSeries {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  weekday     Int
  time        String
  location    String
  description String?
  category    String?
  responsibleId String?
  capacity    Int?
  observations String?
  active      Boolean   @default(true)
  deletedAt   DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  responsible User?     @relation("SeriesResponsible", fields: [responsibleId], references: [id])
  events      Event[]

  @@index([workspaceId, active, deletedAt])
}

model Event {
  id                 String          @id @default(cuid())
  workspaceId        String
  seriesId           String?
  responsibleId      String?
  name               String
  description        String?
  startsAt           DateTime        @db.Timestamptz(3)
  location           String
  category           String?
  capacity           Int?
  status             EventStatus     @default(CONFIRMED)
  scheduleException Boolean         @default(false)
  observations       String?
  deletedAt          DateTime?       @db.Timestamptz(3)
  createdAt          DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime        @updatedAt @db.Timestamptz(3)
  workspace          Workspace       @relation(fields: [workspaceId], references: [id])
  series             RecurringSeries? @relation(fields: [seriesId], references: [id])
  responsible        User?           @relation("EventResponsible", fields: [responsibleId], references: [id])
  attendance         Attendance[]

  @@index([workspaceId, startsAt, status, deletedAt])
  @@index([seriesId, startsAt])
}

model Attendance {
  id         String            @id @default(cuid())
  personId   String
  eventId    String
  recorderId String?
  /// Required for members; null for visitors. Validate against Person.type in the API.
  status     AttendanceStatus?
  notes      String?
  recordedAt DateTime          @default(now()) @db.Timestamptz(3)
  deletedAt  DateTime?         @db.Timestamptz(3)
  person     Person            @relation(fields: [personId], references: [id])
  event      Event             @relation(fields: [eventId], references: [id])
  recorder   User?             @relation("AttendanceRecorder", fields: [recorderId], references: [id])

  /// Enforce one active row per person/event with a PostgreSQL partial unique index in the initial migration.
  @@index([personId, eventId, deletedAt])
  @@index([eventId, status, deletedAt])
  @@index([personId, recordedAt])
}

model AuditLog {
  id          String    @id @default(cuid())
  workspaceId String
  actorId     String?
  action      String
  entityType  String
  entityId    String
  /// Include the prior state needed to undo eligible actions. Personal snapshots must be scrubbed after one week.
  metadata    Json?
  undoable    Boolean   @default(false)
  undoesLogId String?   @unique
  undoExpiresAt DateTime? @db.Timestamptz(3)
  occurredAt  DateTime  @default(now()) @db.Timestamptz(3)
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  actor       User?     @relation(fields: [actorId], references: [id])
  undoesLog   AuditLog? @relation("AuditUndo", fields: [undoesLogId], references: [id])
  undoneBy    AuditLog? @relation("AuditUndo")

  @@index([workspaceId, occurredAt])
  @@index([entityType, entityId])
}
